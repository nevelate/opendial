#include <zephyr/dt-bindings/i2c/i2c.h>
#include <raspberrypi/rpi_pico/rp2040.dtsi>
#include <zephyr/dt-bindings/pinctrl/rpi-pico-rp2040-pinctrl.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <freq.h>

/ {
	aliases {
		sw0 = &button_0;
		magnet = &as5600;
	};

	gpio_keys {
		compatible = "gpio-keys";

		button_0: button_0 {
			label = "main button";
			gpios = <&gpio0 27 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};
}; // Properly closes the root (/) node

&i2c0 {
	status = "okay";
	pinctrl-0 = <&i2c0_custom>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;

	as5600: as5600@36 {
		compatible = "ams,as5600";
		status = "okay";
		reg = <0x36>;
	};
};

&pinctrl {
	i2c0_custom: i2c0_custom {
		group1 {
			pinmux = <I2C0_SDA_P4>;
			input-enable;
		};

		group2 {
			pinmux = <I2C0_SCL_P5>;
			input-enable;
		};
	};
};

/* Reference the RP2040 native USB Device Controller */
&zephyr_udc0 {
	status = "okay";

	/* Define the HID Device instance inside the controller */
	hid_dev_0: hid_dev_0 {
		compatible = "zephyr,hid-device";
		label = "HID0";
		in-report-size = <24>;        /* Match your expected input report size in bytes */
		in-polling-period-us = <1000>; /* Poll interval (1000us = 1ms) */
	};
};

&gpio0 {
	status = "okay";
};
